@@ -34,8 +34,16 @@ fn spawn_encoder(source: &str) -> Result<Child, String> {
         Some(root) => { let mut c = Command::new(root.join("bin/ffmpeg")); c.env("LD_LIBRARY_PATH", root.join("lib/x86_64-linux-gnu")); c }
         None => Command::new("ffmpeg"),
     };
+    // `-f pulse` hands FFmpeg samples that arrive in bursts: with the previous 1920-byte
+    // fragment and no resampler the encoder received 2.9-12% fewer samples than the wall clock,
+    // while the Ogg granule still advanced by real time. The viewer then saw packets whose
+    // timestamps ran ahead of their content, which its jitter buffer turns into a periodic
+    // gap/stutter (heard as crackling) and a growing A/V offset. aresample=async=1 rebuilds the
+    // timeline from the sample count (pads/trims against the nominal rate), which measured
+    // -0.2% instead of +2.9..+12% and is stable across runs.
     command.args(["-hide_banner", "-loglevel", "error", "-nostdin",
             "-f", "pulse", "-fragment_size", "1920", "-i", source, "-vn",
+            "-af", "aresample=48000:async=1:min_hard_comp=0.01",
             "-c:a", "libopus", "-ar", "48000", "-ac", "2", "-b:a", "128k", "-application", "lowdelay",
             "-frame_duration", "20", "-page_duration", "20000", "-flush_packets", "1", "-f", "ogg", "pipe:1"])
         .stdin(Stdio::null()).stdout(Stdio::piped()).stderr(Stdio::inherit());
